generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ChampionshipStage {
  REGISTRATION   // aberto para cadastro de times
  GROUP_STAGE    // fase de grupos em andamento
  KNOCKOUT_STAGE // mata-mata em andamento
  FINISHED       // finalizado, campeao definido
}

enum MatchPhase {
  GROUP
  KNOCKOUT
}

enum MatchStatus {
  SCHEDULED
  PLAYED
}

enum MatchResultType {
  REGULAR
  HOME_WALKOVER
  AWAY_WALKOVER
  DOUBLE_WALKOVER
}

enum MatchPlayerStatSource {
  EA
  MANUAL
}

enum ChampionshipApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  discordId    String?  @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())

  captainOf    Team[]   @relation("TeamCaptain")
  matchReadiness MatchReadiness[]
  openedDisputes MatchDispute[] @relation("DisputeOpenedBy")
  resolvedDisputes MatchDispute[] @relation("DisputeResolvedBy")
}

model Championship {
  id                    String            @id @default(uuid())
  name                  String
  description           String?
  maxTeams              Int
  numberOfGroups        Int               @default(1)
  teamsQualifyingPerGroup Int             @default(2)
  stage                 ChampionshipStage @default(REGISTRATION)
  championTeamId        String?
  championTeam          Team?             @relation("ChampionTeam", fields: [championTeamId], references: [id])
  championTeamName      String?
  championDefinedAt     DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  teams         Team[]                    @relation("ChampionshipTeams")
  applications  ChampionshipApplication[]
  groups        Group[]
  matches       Match[]
}

model Team {
  id             String       @id @default(uuid())
  name           String
  logoUrl        String?
  eaClubId       String?
  captainUserId  String?
  captainUser    User?        @relation("TeamCaptain", fields: [captainUserId], references: [id], onDelete: SetNull)
  championshipId String?
  championship   Championship? @relation("ChampionshipTeams", fields: [championshipId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  applications   ChampionshipApplication[]
  groupEntries   GroupTeam[]
  homeMatches    Match[]      @relation("HomeTeam")
  awayMatches    Match[]      @relation("AwayTeam")
  wonMatches     Match[]      @relation("WinnerTeam")
  championOf     Championship[] @relation("ChampionTeam")
  players        Player[]
  matchReadiness MatchReadiness[]
  disputes       MatchDispute[]

  @@unique([championshipId, name])
}

model ChampionshipApplication {
  id             String                       @id @default(uuid())
  teamId         String
  championshipId String
  status         ChampionshipApplicationStatus @default(PENDING)
  reviewedAt     DateTime?
  approvedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  team           Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  championship   Championship                 @relation(fields: [championshipId], references: [id], onDelete: Cascade)

  @@unique([teamId, championshipId])
  @@index([championshipId, status])
}

model Group {
  id             String       @id @default(uuid())
  name           String
  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)

  teams   GroupTeam[]
  matches Match[]

  @@unique([championshipId, name])
}

model GroupTeam {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId])
}

model Match {
  id             String       @id @default(uuid())
  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)

  phase   MatchPhase
  groupId String?
  group   Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // usado apenas na fase de mata-mata, ex: "Oitavas", "Quartas", "Semifinal", "Final"
  round      String?
  // ordem do jogo dentro da rodada/mata-mata, usada para montar o chaveamento
  roundOrder Int?

  homeTeamId String?
  homeTeam   Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String?
  awayTeam   Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homeScore Int?
  awayScore Int?

  // desempate por penaltis, usado apenas no mata-mata em caso de empate
  homePenalty Int?
  awayPenalty Int?

  winnerTeamId String?
  winnerTeam   Team?  @relation("WinnerTeam", fields: [winnerTeamId], references: [id])

  status    MatchStatus @default(SCHEDULED)
  resultType MatchResultType @default(REGULAR)
  resultNote String?
  scheduledAt DateTime?
  discordChannelId  String?
  discordChannelUrl String?
  startedAt         DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  playerStats MatchPlayerStat[]
  readiness   MatchReadiness[]
  disputes    MatchDispute[]
}

model MatchReadiness {
  id        String   @id @default(uuid())
  matchId   String
  teamId    String
  userId    String
  readyAt   DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId])
  @@index([userId])
}
model MatchDispute {
  id               String        @id @default(uuid())
  matchId          String
  teamId           String
  openedByUserId   String
  status           DisputeStatus @default(OPEN)
  reason           String
  resolutionNote   String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  match          Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team           Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  openedByUser   User  @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)
  resolvedByUser User? @relation("DisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([matchId, status])
  @@unique([matchId, teamId, status])
}
model Player {
  id         String   @id @default(uuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name       String
  externalId String?
  position   String?
  isManual   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  matchStats MatchPlayerStat[]


  @@unique([teamId, name])
  @@index([teamId])
}
model MatchPlayerStat {
  id        String                @id @default(uuid())
  matchId   String
  playerId  String
  goals     Int                   @default(0)
  assists   Int                   @default(0)
  source    MatchPlayerStatSource @default(MANUAL)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
}
