# URL de conexao do PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fc_pro_clubs?schema=public"

# Porta da API
PORT=3333

# Segredo usado para assinar os tokens JWT (obrigatorio em producao)
JWT_SECRET="troque-este-segredo-em-producao"

# Tempo de expiracao do token
JWT_EXPIRES_IN="8h"

# Credenciais do administrador criadas pelo script de seed (prisma/seed.ts)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_EMAIL="admin@proclubs.local"
ADMIN_DISCORD_ID="admin"

# Proxy reverso confiavel: habilite somente quando o proxy preservar o IP do cliente
FRONTEND_URL="http://localhost:5173"
TRUST_PROXY="false"
# Configuracao do bot Discord (o bot precisa de Manage Channels no servidor)
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
# Categoria opcional onde os canais de partida serao criados
DISCORD_CATEGORY_ID=""
# IDs dos administradores do Discord separados por virgula (opcional)
DISCORD_ADMIN_IDS=""
# OAuth2 do Discord para vincular a conta do usuario
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3333/api/auth/discord/callback"
# Plataforma usada nas consultas da API do EA Pro Clubs
EA_PLATFORM="common-gen5"
# Fallback para redes onde a Hostinger nao consegue acessar a EA diretamente
EA_READER_PROXY_BASE_URL="https://r.jina.ai/http://"
