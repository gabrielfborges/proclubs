# URL de conexao do PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fc_pro_clubs?schema=public"

# Porta da API
PORT=3333

# Segredo usado para assinar os tokens JWT do admin (troque em producao)
JWT_SECRET="troque-este-segredo-em-producao"

# Tempo de expiracao do token JWT
JWT_EXPIRES_IN="8h"

# Credenciais do administrador criadas pelo script de seed (prisma/seed.ts)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Origem permitida para requisicoes do frontend (CORS)
FRONTEND_URL="http://localhost:5173"
